local function resolveSafeTarget(targetCF,character,humanoid,root)
    if not targetCF or not character or not humanoid or not root then
        return targetCF
    end
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={character}
    local result=workspace:Raycast(targetCF.Position+Vector3.new(0,8,0),Vector3.new(0,-20,0),params)
    if not result or not result.Instance or not result.Instance.CanCollide then
        return targetCF
    end
    if result.Position.Y>targetCF.Position.Y+3 then
        return targetCF
    end
    local rootHalfHeight=root.Size.Y*0.5
    local y=result.Position.Y+humanoid.HipHeight+rootHalfHeight+0.05
    return CFrame.new(targetCF.Position.X,y,targetCF.Position.Z)*targetCF.Rotation
end
local function getGroundedState(humanoid)
    return humanoid.FloorMaterial
        ~= Enum.Material.Air
end
local function tryVerticalAssist(targetPosition,humanoid,root,token,precise)
    if not targetPosition or not humanoid or not root then
        return false,false
    end
    local timeout=precise and 18 or 12
    local started=os.clock()
    local lastProgressY=root.Position.Y
    local lastProgress=os.clock()
    local noProgress=0
    local side=1
    local movedUp=false
    while token==movementToken and humanoid.Health>0 and root.Parent and os.clock()-started<timeout do
        local delta=targetPosition-root.Position
        local horizontal=Vector3.new(delta.X,0,delta.Z)
        local horizontalDistance=horizontal.Magnitude
        if math.abs(delta.Y)<=0.9 and horizontalDistance<= (precise and 1 or 1.8) then
            return true,movedUp
        end
        local direction=horizontalDistance>0.05 and horizontal.Unit or Vector3.zero
        local forwardDistance=math.min(horizontalDistance,precise and 4 or 5)
        local sideDirection=direction~=Vector3.zero and Vector3.new(-direction.Z,0,direction.X)*side*(precise and 1.25 or 1.5) or Vector3.zero
        local probe=root.Position+direction*forwardDistance+sideDirection
        local moveTarget=Vector3.new(probe.X,root.Position.Y,probe.Z)
        local finished=false
        local reached=false
        local finishedConnection=humanoid.MoveToFinished:Connect(function(success)
            finished=true
            reached=success
        end)
        humanoid:MoveTo(moveTarget)
        if getGroundedState(humanoid) then
            humanoid.Jump=true
            pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)
        end
        local attemptStarted=os.clock()
        local leftGround=false
        while token==movementToken and humanoid.Health>0 and root.Parent and not finished and os.clock()-attemptStarted<(precise and 2.6 or 2.5) do
            if not getGroundedState(humanoid) then
                leftGround=true
            elseif leftGround and os.clock()-attemptStarted>0.25 then
                break
            end
            local currentDelta=targetPosition-root.Position
            local currentHorizontal=Vector3.new(currentDelta.X,0,currentDelta.Z)
            if math.abs(currentDelta.Y)<=0.9 and currentHorizontal.Magnitude<=(precise and 1 or 1.8) then
                reached=true
                break
            end
            RunService.Heartbeat:Wait()
        end
        pcall(function() finishedConnection:Disconnect() end)
        if token~=movementToken then
            return false,movedUp
        end
        local landingStarted=os.clock()
        while token==movementToken and humanoid.Health>0 and root.Parent and not getGroundedState(humanoid) and os.clock()-landingStarted<3 do
            RunService.Heartbeat:Wait()
        end
        local newY=root.Position.Y
        if newY>lastProgressY+0.35 then
            lastProgressY=newY
            lastProgress=os.clock()
            noProgress=0
            movedUp=true
            side=-side
        elseif os.clock()-lastProgress>=2.5 then
            noProgress+=1
            lastProgress=os.clock()
            side=-side
            if noProgress>=2 then
                return false,movedUp
            end
        end
        if reached then
            local currentDelta=targetPosition-root.Position
            local currentHorizontal=Vector3.new(currentDelta.X,0,currentDelta.Z)
            if math.abs(currentDelta.Y)<=0.9 and currentHorizontal.Magnitude<=(precise and 1 or 1.8) then
                return true,movedUp
            end
        end
    end
    local finalDelta=targetPosition-root.Position
    local finalHorizontal=Vector3.new(finalDelta.X,0,finalDelta.Z)
    return math.abs(finalDelta.Y)<=0.9 and finalHorizontal.Magnitude<=(precise and 1 or 1.8),movedUp
end
local function waitForGround(
    humanoid,
    token
)
    local started =
        os.clock()
    while token == movementToken
        and humanoid.Health > 0
        and not getGroundedState(humanoid)
        and os.clock() - started < 1.5 do
        RunService.Heartbeat:Wait()
    end
end
local function getPathTarget(
    targetPosition,
    character
)
    local params =
        RaycastParams.new()
    params.FilterType =
        Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {
        character
    }
    local result =
        workspace:Raycast(
            targetPosition
                + Vector3.new(
                    0,
                    8,
                    0
                ),
            Vector3.new(
                0,
                -20,
                0
            ),
            params
        )
    if result
        and result.Instance
        and result.Instance.CanCollide then
        return result.Position
    end
    return targetPosition
end
local function createPath(root,destination,precise)
    local path=PathfindingService:CreatePath({
        AgentRadius=2,
        AgentHeight=5,
        AgentCanJump=true,
        AgentCanClimb=true,
        WaypointSpacing=precise and 2 or 4
    })
    local success=pcall(function()
        path:ComputeAsync(root.Position,destination)
    end)
    if not success or path.Status~=Enum.PathStatus.Success then
        return nil
    end
    return path
end
local function runPathfinding(targetCF,speed,token,precise)
    local character,humanoid,root=getCharacter()
    if not character or not humanoid or not root then
        return false
    end
    local oldWalkSpeed=humanoid.WalkSpeed
    local oldAutoRotate=humanoid.AutoRotate
    local oldPlatformStand=humanoid.PlatformStand
    local oldSit=humanoid.Sit
    local cleaned=false
    local blockedConnection
    local function cleanup()
        if cleaned then
            return
        end
        cleaned=true
        if blockedConnection then
            pcall(function() blockedConnection:Disconnect() end)
            blockedConnection=nil
        end
        stopHumanoid(humanoid)
        restoreHumanoid(humanoid,oldWalkSpeed,oldAutoRotate,oldPlatformStand,oldSit)
        zeroVelocity(root)
    end
    activeCleanup=cleanup
    humanoid.PlatformStand=false
    humanoid.Sit=false
    humanoid.AutoRotate=true
    humanoid.WalkSpeed=math.max(speed,1)
    waitForGround(humanoid,token)
    if token~=movementToken then
        cleanup()
        return false
    end
    local pathTarget=getPathTarget(targetCF.Position,character)
    local waypointTolerance=precise and 0.75 or 1.5
    local finalTolerance=precise and 0.8 or 2
    local started=os.clock()
    local function disconnectBlocked()
        if blockedConnection then
            pcall(function() blockedConnection:Disconnect() end)
            blockedConnection=nil
        end
    end
    while token==movementToken and humanoid.Health>0 and root.Parent do
        if os.clock()-started>=60 then
            cleanup()
            return false
        end
        if (root.Position-targetCF.Position).Magnitude<=finalTolerance then
            break
        end
        disconnectBlocked()
        local path=createPath(root,pathTarget,precise)
        if not path then
            local verticalDifference=targetCF.Position.Y-root.Position.Y
            if verticalDifference>1.5 then
                local assistReached,assistProgress=tryVerticalAssist(targetCF.Position,humanoid,root,token,precise)
                if token~=movementToken then
                    cleanup()
                    return false
                end
                if assistReached then
                    break
                end
                if assistProgress then
                    pathTarget=getPathTarget(targetCF.Position,character)
                    task.wait(0.05)
                    continue
                end
            end
            task.wait(0.2)
            continue
        end
        local waypoints=path:GetWaypoints()
        if #waypoints<2 then
            task.wait(0.15)
            continue
        end
        local blocked=false
        blockedConnection=path.Blocked:Connect(function(blockedIndex)
            if blockedIndex>=2 then
                blocked=true
            end
        end)
        local needRepath=false
        for index=2,#waypoints do
            if token~=movementToken or humanoid.Health<=0 or not root.Parent then
                cleanup()
                return false
            end
            if blocked then
                needRepath=true
                break
            end
            local waypoint=waypoints[index]
            if (root.Position-waypoint.Position).Magnitude<=waypointTolerance then
                continue
            end
            local reached=false
            local finished=false
            local finishedConnection=humanoid.MoveToFinished:Connect(function(success)
                finished=true
                reached=success
            end)
            humanoid:MoveTo(waypoint.Position)
            local jumpWaypoint=waypoint.Action==Enum.PathWaypointAction.Jump
            if jumpWaypoint then
                humanoid.Jump=true
                pcall(function() humanoid:ChangeState(Enum.HumanoidStateType.Jumping) end)
            end
            local waypointStarted=os.clock()
            local leftGround=false
            local landed=not jumpWaypoint
            while token==movementToken and humanoid.Health>0 and root.Parent and not finished and not blocked do
                local distance=(root.Position-waypoint.Position).Magnitude
                local grounded=getGroundedState(humanoid)
                if not grounded then
                    leftGround=true
                elseif jumpWaypoint and leftGround then
                    landed=true
                end
                if distance<=waypointTolerance and (not jumpWaypoint or landed) then
                    reached=true
                    break
                end
                if os.clock()-waypointStarted>=8 then
                    break
                end
                RunService.Heartbeat:Wait()
            end
            pcall(function() finishedConnection:Disconnect() end)
            if token~=movementToken or humanoid.Health<=0 or not root.Parent then
                cleanup()
                return false
            end
            if blocked then
                needRepath=true
                break
            end
            if not reached and (root.Position-waypoint.Position).Magnitude>waypointTolerance then
                needRepath=true
                break
            end
            if jumpWaypoint then
                local landingStarted=os.clock()
                while token==movementToken and humanoid.Health>0 and root.Parent and not getGroundedState(humanoid) and os.clock()-landingStarted<4 do
                    RunService.Heartbeat:Wait()
                end
                if token~=movementToken then
                    cleanup()
                    return false
                end
            end
        end
        disconnectBlocked()
        if token~=movementToken then
            cleanup()
            return false
        end
        if (root.Position-targetCF.Position).Magnitude<=finalTolerance then
            break
        end
        local verticalDifference=targetCF.Position.Y-root.Position.Y
        if needRepath and verticalDifference>1.5 then
            local assistReached,assistProgress=tryVerticalAssist(targetCF.Position,humanoid,root,token,precise)
            if token~=movementToken then
                cleanup()
                return false
            end
            if assistReached then
                break
            end
            if assistProgress then
                pathTarget=getPathTarget(targetCF.Position,character)
                task.wait(0.05)
                continue
            end
        end
        if needRepath then
            task.wait(0.05)
            continue
        end
        local targetDistance=(root.Position-targetCF.Position).Magnitude
        if targetDistance>finalTolerance and verticalDifference>1.5 then
            local horizontalDistance=Vector3.new(
                targetCF.Position.X-root.Position.X,
                0,
                targetCF.Position.Z-root.Position.Z
            ).Magnitude
            if horizontalDistance<=12 then
                local assistReached,assistProgress=tryVerticalAssist(targetCF.Position,humanoid,root,token,precise)
                if token~=movementToken then
                    cleanup()
                    return false
                end
                if assistReached then
                    break
                end
                if assistProgress then
                    pathTarget=getPathTarget(targetCF.Position,character)
                    task.wait(0.05)
                    continue
                end
            end
        end
        task.wait(0.05)
    end
    if token~=movementToken then
        cleanup()
        return false
    end
    stopHumanoid(humanoid)
    zeroVelocity(root)
    if (root.Position-targetCF.Position).Magnitude<=3 then
        if precise then
            character:PivotTo(getTargetPivot(character,root,targetCF))
        else
            local currentY=root.Position.Y
            root.CFrame=CFrame.new(targetCF.Position.X,currentY,targetCF.Position.Z)*targetCF.Rotation
        end
        zeroVelocity(root)
    end
    cleanup()
    finishMovement(token)
    return true
end
local function runPhysicsRep(
    targetCF,
    speed,
    token,
    safeLandingOverride
)
    local character, humanoid, root = getCharacter()
    if not character or not humanoid or not root then
        return false
    end
    if type(sethiddenproperty) ~= "function" then
        notify("PhysicsRep","Tu executor no expone PhysicsRepRootPart.")
        return false
    end
    local useSafeLanding = safeLanding
    if type(safeLandingOverride) == "boolean" then
        useSafeLanding = safeLandingOverride
    end
    local finalTarget = targetCF
    if useSafeLanding then
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {character}
        local result = workspace:Raycast(targetCF.Position + Vector3.new(0,8,0),Vector3.new(0,-20,0),params)
        if result and result.Instance and result.Instance:IsA("BasePart") and result.Instance.CanCollide and result.Position.Y <= targetCF.Position.Y + 3 then
            local rootHalfHeight = root.Size.Y * 0.5
            local y = result.Position.Y + humanoid.HipHeight + rootHalfHeight + 0.05
            finalTarget = CFrame.new(targetCF.Position.X,y,targetCF.Position.Z) * targetCF.Rotation
        end
    end
    local referencePart
    do
        local params = OverlapParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        params.FilterDescendantsInstances = {character}
        local parts = workspace:GetPartBoundsInRadius(root.Position,100,params)
        local bestDistance = math.huge
        local fallbackPart
        for _,part in ipairs(parts) do
            if part:IsA("BasePart") and part ~= root and part.Parent then
                local distance = (part.Position - root.Position).Magnitude
                if not part.Anchored and distance < bestDistance then
                    bestDistance = distance
                    referencePart = part
                end
                if not fallbackPart then
                    fallbackPart = part
                end
            end
        end
        if not referencePart then
            referencePart = fallbackPart
        end
        if not referencePart then
            local params2 = RaycastParams.new()
            params2.FilterType = Enum.RaycastFilterType.Exclude
            params2.FilterDescendantsInstances = {character}
            local result = workspace:Raycast(finalTarget.Position + Vector3.new(0,8,0),Vector3.new(0,-20,0),params2)
            if result and result.Instance and result.Instance:IsA("BasePart") and result.Instance ~= root then
                referencePart = result.Instance
            end
        end
    end
    if not referencePart then
        notify("PhysicsRep","No se encontró una BasePart de referencia.")
        return false
    end
    local oldWalkSpeed = humanoid.WalkSpeed
    local oldJumpPower = humanoid.JumpPower
    local oldJumpHeight = humanoid.JumpHeight
    local oldAutoRotate = humanoid.AutoRotate
    local oldPlatformStand = humanoid.PlatformStand
    local oldSit = humanoid.Sit
    local cleaned = false
    local connection
    local function cleanup()
        if cleaned then
            return
        end
        cleaned = true
        if connection then
            pcall(function() connection:Disconnect() end)
            connection = nil
        end
        pcall(function() sethiddenproperty(root,"PhysicsRepRootPart",nil) end)
        if root and root.Parent then
            pcall(function()
                root.AssemblyLinearVelocity = Vector3.zero
                root.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        if humanoid and humanoid.Parent then
            pcall(function() humanoid.WalkSpeed = oldWalkSpeed end)
            pcall(function() humanoid.JumpPower = oldJumpPower end)
            pcall(function() humanoid.JumpHeight = oldJumpHeight end)
            pcall(function() humanoid.AutoRotate = oldAutoRotate end)
            pcall(function() humanoid.PlatformStand = oldPlatformStand end)
            pcall(function() humanoid.Sit = oldSit end)
        end
    end
    activeCleanup = cleanup
    humanoid.AutoRotate = false
    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0
    pcall(function() humanoid.JumpHeight = 0 end)
    humanoid.PlatformStand = false
    humanoid.Sit = false
    local ok = pcall(function()
        sethiddenproperty(root,"PhysicsRepRootPart",referencePart)
    end)
    if not ok then
        cleanup()
        notify("PhysicsRep","No se pudo asignar PhysicsRepRootPart.")
        return false
    end
    connection = RunService.Heartbeat:Connect(function()
        if token ~= movementToken or not root.Parent or not character.Parent then
            return
        end
        pcall(function()
            sethiddenproperty(root,"PhysicsRepRootPart",referencePart)
        end)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    local startCF = root.CFrame
    local distance = (root.Position - finalTarget.Position).Magnitude
    local duration = math.max(distance / math.max(speed,1),0.05)
    local started = os.clock()
    while token == movementToken and root.Parent and humanoid.Health > 0 do
        local elapsed = os.clock() - started
        local alpha = math.clamp(elapsed / duration,0,1)
        local smoothAlpha = alpha * alpha * (3 - 2 * alpha)
        local currentCF = startCF:Lerp(finalTarget,smoothAlpha)
        root.CFrame = currentCF
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        if alpha >= 1 then
            break
        end
        RunService.Heartbeat:Wait()
    end
    if token ~= movementToken or not root.Parent or humanoid.Health <= 0 then
        cleanup()
        return false
    end
    root.CFrame = finalTarget
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    cleanup()
    finishMovement(token)
    return true
end
local function runAlignPosition(
    targetCF,
    speed,
    token
)
    local _, humanoid, root =
        getCharacter()
    if not humanoid or not root then
        return false
    end
    local attachment =
        Instance.new(
            "Attachment"
        )
    attachment.Name =
        "JmodsTP_Attachment"
    attachment.Parent =
        root
    local align =
        Instance.new(
            "AlignPosition"
        )
    align.Name =
        "JmodsTP_AlignPosition"
    align.Mode =
        Enum.PositionAlignmentMode.OneAttachment
    align.Attachment0 =
        attachment
    align.Position =
        targetCF.Position
    align.MaxForce =
        math.huge
    align.MaxVelocity =
        math.max(
            speed,
            1
        )
    align.Responsiveness =
        math.clamp(
            speed * 2,
            5,
            200
        )
    align.ApplyAtCenterOfMass =
        true
    align.RigidityEnabled =
        false
    align.Parent =
        root
    local cleanupDone = false
    local function cleanup()
        if cleanupDone then
            return
        end
        cleanupDone = true
        pcall(function()
            align:Destroy()
        end)
        pcall(function()
            attachment:Destroy()
        end)
    end
    activeCleanup = cleanup
    local started =
        os.clock()
    while token == movementToken do
        if humanoid.Health <= 0
            or not root.Parent then
            cleanup()
            return false
        end
        local distance =
            (
                root.Position
                - targetCF.Position
            ).Magnitude
        if distance <= 1 then
            break
        end
        if os.clock() - started >= 30 then
            break
        end
        RunService.Heartbeat:Wait()
    end
    if token ~= movementToken then
        cleanup()
        return false
    end
    root.CFrame =
        targetCF
    zeroVelocity(root)
    cleanup()
    finishMovement(token)
    return true
end
