                    nil
            end
        end
    })
TeleportsTab:CreateButton({
    Name = "Borrar TP seleccionado",
    Callback = function()
        if not deleteSelected
            or not savedTPs[deleteSelected] then
            notify(
                "Teleports",
                "Selecciona un TP para borrar."
            )
            return
        end
        local deleted =
            deleteSelected
        savedTPs[deleted] =
            nil
        if tp1Selected == deleted then
            tp1Selected = nil
        end
        if tp2Selected == deleted then
            tp2Selected = nil
        end
        if tp3Selected == deleted then
            tp3Selected = nil
        end
        deleteSelected = nil
        saveStorage()
        refreshDropdowns()
        notify(
            "TP eliminado",
            "Eliminado: " .. deleted
        )
    end
})
