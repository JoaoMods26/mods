local function getTargetPivot(
    character,
    root,
    targetRootCFrame
)
    local currentRoot = root.CFrame
    local currentPivot = character:GetPivot()
    local rootToPivot =
        currentRoot:ToObjectSpace(
            currentPivot
        )
    return targetRootCFrame * rootToPivot
end
