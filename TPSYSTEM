local function runVelocityGravity(
    targetCF,
    speed,
    token
)
    local _, humanoid, root =
        getCharacter()
    if not humanoid or not root then
        return false
    end
    local started =
        os.clock()
    local cleanupDone = false
    local function cleanup()
        if cleanupDone then
            return
        end
        cleanupDone = true
        zeroVelocity(root)
    end
    activeCleanup = cleanup
    while token == movementToken do
        if humanoid.Health <= 0
            or not root.Parent then
            cleanup()
            return false
        end
        local delta =
            targetCF.Position
            - root.Position
        local horizontal =
            Vector3.new(
                delta.X,
                0,
                delta.Z
            )
        local distance =
            horizontal.Magnitude
        if distance <= 2.5 then
            break
        end
        if os.clock() - started >= 30 then
            break
        end
        local horizontalVelocity =
            Vector3.zero
        if distance > 0 then
            horizontalVelocity =
                horizontal.Unit
                * math.max(
                    speed,
                    1
                )
        end
        local vertical =
            root.AssemblyLinearVelocity.Y
        root.AssemblyLinearVelocity =
            Vector3.new(
                horizontalVelocity.X,
                vertical,
                horizontalVelocity.Z
            )
        RunService.Heartbeat:Wait()
    end
    if token ~= movementToken then
        cleanup()
        return false
    end
    root.CFrame =
        targetCF
    zeroVelocity(root)
    cleanup()
    finishMovement(token)
    return true
end
local function performTeleport(
    targetCF,
    mode,
    speed,
    instant,
    safeLandingOverride
)
    if not targetCF then
        notify(
            "Teleport",
            "El TP seleccionado no existe."
        )
        return
    end
    local token =
        beginMovement(mode)
    local _, _, root =
        getCharacter()
    if not root then
        cancelMovement()
        notify(
            "Teleport",
            "No se encontró tu personaje."
        )
        return
    end
    if instant then
        pivotToTarget(
            targetCF
        )
        finishMovement(token)
        return
    end
    if mode == "CFrame" then
        directCFrame(
            targetCF
        )
        finishMovement(token)
    elseif mode == "Tween" then
        task.spawn(function()
            runTween(
                targetCF,
                speed,
                token
            )
        end)
    elseif mode == "CFrame Suave" then
        task.spawn(function()
            runSmoothCFrame(
                targetCF,
                speed,
                token
            )
        end)
    elseif mode == "MoveTo" then
        task.spawn(function()
            runMoveTo(
                targetCF,
                speed,
                token
            )
        end)
    elseif mode == "Pathfinding" then
        task.spawn(function()
            runPathfinding(
                targetCF,
                speed,
                token,
                false
            )
        end)
    elseif mode == "Pathfinding Preciso" then
        task.spawn(function()
            runPathfinding(
                targetCF,
                speed,
                token,
                true
            )
        end)
    elseif mode == "PhysicsRep" then
        task.spawn(function()
            runPhysicsRep(
                targetCF,
                speed,
                token,
                safeLandingOverride
            )
        end)
    elseif mode == "AlignPosition" then
        task.spawn(function()
            runAlignPosition(
                targetCF,
                speed,
                token
            )
        end)
    elseif mode == "LinearVelocity" then
        task.spawn(function()
            runLinearVelocity(
                targetCF,
                speed,
                token
            )
        end)
    elseif mode == "Velocidad + Gravedad" then
        task.spawn(function()
            runVelocityGravity(
                targetCF,
                speed,
                token
            )
        end)
    else
        finishMovement(token)
    end
end
local function getSettingsForTP(name)
    local data =
        getTPData(name)
    local mode =
        selectedMode
    local speed =
        teleportSpeed
    local instant =
        instantTeleport
    local savedSafeLanding =
        safeLanding
    if useSavedSettings
        and data then
        if table.find(
            MODE_OPTIONS,
            data.mode
        ) then
            mode =
                data.mode
        end
        if type(data.speed)
            == "number" then
            speed =
                data.speed
        end
        if type(data.instant)
            == "boolean" then
            instant =
                data.instant
        end
        if type(data.safeLanding)
            == "boolean" then
            savedSafeLanding =
                data.safeLanding
        end
    end
    return mode, speed, instant, savedSafeLanding
end
local function loadSlot(slot)
    local selected =
        getSlotSelection(slot)
    if not selected then
        notify(
            "Teleports",
            "Selecciona un TP para el Slot " .. slot .. "."
        )
        return
    end
