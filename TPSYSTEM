local function finishMovement(token)
    if token ~= movementToken then
        return false
    end
    if activeCleanup then
        pcall(activeCleanup)
    end
    activeCleanup = function() end
    activeMovementName = nil
    return true
end
local function cancelMovement()
    movementToken += 1
    local cleanup = activeCleanup
    activeCleanup = function() end
    activeMovementName = nil
    if cleanup then
        pcall(cleanup)
    end
    local _, humanoid, root = getCharacter()
    if humanoid then
        stopHumanoid(humanoid)
    end
    if root then
        zeroVelocity(root)
    end
end
local function beginMovement(name)
