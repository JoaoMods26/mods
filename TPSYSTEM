local function hasFileSystem()
    return type(isfolder) == "function"
        and type(makefolder) == "function"
        and type(isfile) == "function"
        and type(readfile) == "function"
        and type(writefile) == "function"
end
local function prepareStorage()
    if not hasFileSystem() then
        return false
    end
    pcall(function()
        if not isfolder(SAVE_ROOT) then
            makefolder(SAVE_ROOT)
        end
    end)
    pcall(function()
        if not isfolder(SAVE_FOLDER) then
            makefolder(SAVE_FOLDER)
        end
    end)
    return true
end
local function getCharacter()
    local character = LocalPlayer.Character
    if not character or not character.Parent then
        return nil
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then
        return nil
    end
    if humanoid.Health <= 0 then
        return nil
    end
    return character, humanoid, root
end
local function serializeCFrame(cf)
    return {
        cf:GetComponents()
    }
end
local function deserializeCFrame(data)
    if type(data) ~= "table" or #data < 12 then
        return nil
    end
    local success, result = pcall(function()
        return CFrame.new(table.unpack(data))
    end)
    if success then
        return result
    end
    return nil
end
local function saveStorage()
    if not hasFileSystem() then
        return false
    end
    local data = {
        version = 6,
        tps = savedTPs,
        slots = {
            tp1 = tp1Selected,
            tp2 = tp2Selected,
            tp3 = tp3Selected
        }
    }
    return pcall(function()
        writefile(
            SAVE_FILE,
            HttpService:JSONEncode(data)
        )
    end)
end
local function loadStorage()
    if not prepareStorage() then
        savedTPs = {}
        tp1Selected = nil
        tp2Selected = nil
        tp3Selected = nil
        return false
    end
    if not isfile(SAVE_FILE) then
        savedTPs = {}
        tp1Selected = nil
        tp2Selected = nil
        tp3Selected = nil
        return true
    end
    local success, decoded = pcall(function()
        return HttpService:JSONDecode(
            readfile(SAVE_FILE)
        )
    end)
    if not success or type(decoded) ~= "table" then
        savedTPs = {}
        return false
    end
    if type(decoded.tps) == "table" then
        savedTPs = decoded.tps
        if type(decoded.slots) == "table" then
            tp1Selected = decoded.slots.tp1
            tp2Selected = decoded.slots.tp2
            tp3Selected = decoded.slots.tp3
        end
    else
        savedTPs = decoded
    end
    if tp1Selected and not savedTPs[tp1Selected] then
        tp1Selected = nil
    end
    if tp2Selected and not savedTPs[tp2Selected] then
        tp2Selected = nil
    end
    if tp3Selected and not savedTPs[tp3Selected] then
        tp3Selected = nil
    end
    return true
end
local function getTPNames()
    local names = {}
    for name in pairs(savedTPs) do
        if type(name) == "string" then
            table.insert(names, name)
        end
    end
    table.sort(names, function(a, b)
        return a:lower() < b:lower()
    end)
    if #names == 0 then
        return {
            "Sin TPs guardados"
        }
    end
    return names
end
local function getTPData(name)
    if not name or name == "Sin TPs guardados" then
        return nil
    end
    return savedTPs[name]
end
local function getTP(name)
    local data = getTPData(name)
    if not data then
        return nil
    end
    return deserializeCFrame(
        data.cframe
