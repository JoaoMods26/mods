        getTP(selected)
    if not target then
        notify(
            "Teleports",
            "El TP seleccionado ya no existe."
        )
        return
    end
    local mode
    local speed
    local instant
    local savedSafeLanding
    mode, speed, instant, savedSafeLanding =
        getSettingsForTP(
            selected
        )
    performTeleport(
        target,
        mode,
        speed,
        instant,
        savedSafeLanding
    )
end
