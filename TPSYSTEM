local function runTween(
    targetCF,
    speed,
    token
)
    local character, humanoid, root =
        getCharacter()
    if not character
        or not humanoid
        or not root then
        return false
    end
    local startPivot =
        character:GetPivot()
    local targetPivot =
        getTargetPivot(
            character,
            root,
            targetCF
        )
    local distance =
        (
            startPivot.Position
            - targetPivot.Position
        ).Magnitude
    if distance <= 0.05 then
        character:PivotTo(
            targetPivot
        )
        zeroVelocity(root)
        finishMovement(token)
        return true
    end
    local duration =
        math.max(
            distance
            / math.max(speed, 1),
            0.05
        )
    local alpha =
        Instance.new("NumberValue")
    alpha.Value = 0
    local tween =
        TweenService:Create(
            alpha,
            TweenInfo.new(
                duration,
                Enum.EasingStyle.Linear,
                Enum.EasingDirection.Out
            ),
            {
                Value = 1
            }
        )
    local renderName =
        "JmodsTween_" .. tostring(token)
    local cleanupDone = false
    local function cleanup()
        if cleanupDone then
            return
        end
        cleanupDone = true
        pcall(function()
            tween:Cancel()
        end)
        pcall(function()
            RunService:UnbindFromRenderStep(
                renderName
            )
        end)
        pcall(function()
            alpha:Destroy()
        end)
    end
    activeCleanup = cleanup
    RunService:BindToRenderStep(
        renderName,
        Enum.RenderPriority.Character.Value + 2,
        function()
            if token ~= movementToken then
                return
            end
            if not character.Parent then
                return
            end
            character:PivotTo(
                startPivot:Lerp(
                    targetPivot,
                    alpha.Value
                )
            )
        end
    )
    tween:Play()
    tween.Completed:Wait()
    if token ~= movementToken then
        cleanup()
        return false
    end
    character:PivotTo(
        targetPivot
    )
    zeroVelocity(root)
    cleanup()
    finishMovement(token)
    return true
end
local function runSmoothCFrame(
    targetCF,
    speed,
    token
)
    local character, humanoid, root =
        getCharacter()
    if not character
        or not humanoid
        or not root then
        return false
    end
    local currentPivot =
        character:GetPivot()
    local targetPivot =
        getTargetPivot(
            character,
            root,
            targetCF
        )
    local distance =
        (
            currentPivot.Position
            - targetPivot.Position
        ).Magnitude
    if distance <= 0.05 then
        character:PivotTo(
            targetPivot
        )
        zeroVelocity(root)
        finishMovement(token)
        return true
    end
    local smoothTime =
        math.clamp(
            distance
            / math.max(speed, 1)
            * 0.42,
            0.06,
            0.6
        )
    local velocity =
        CFrame.new()
    local renderName =
        "JmodsSmooth_" .. tostring(token)
    local done = false
    local function cleanup()
        if done then
            return
        end
        done = true
        pcall(function()
            RunService:UnbindFromRenderStep(
                renderName
            )
        end)
    end
    activeCleanup = cleanup
    RunService:BindToRenderStep(
        renderName,
        Enum.RenderPriority.Character.Value + 2,
        function(dt)
            if token ~= movementToken then
                return
            end
            if not character.Parent
                or humanoid.Health <= 0 then
                return
            end
            currentPivot, velocity =
                TweenService:SmoothDamp(
                    currentPivot,
                    targetPivot,
                    velocity,
                    smoothTime,
                    math.huge,
                    dt
                )
            character:PivotTo(
                currentPivot
            )
        end
    )
    local started =
        os.clock()
    while token == movementToken do
        if not character.Parent
            or humanoid.Health <= 0 then
            cleanup()
            return false
        end
        local remaining =
            (
                currentPivot.Position
                - targetPivot.Position
            ).Magnitude
        if remaining <= 0.08 then
            break
        end
        if os.clock() - started >
            math.max(
                3,
                distance
                    / math.max(speed, 1)
                    * 4
            ) then
            break
        end
        RunService.Heartbeat:Wait()
    end
    if token ~= movementToken then
        cleanup()
        return false
    end
    character:PivotTo(
        targetPivot
    )
    zeroVelocity(root)
    cleanup()
    finishMovement(token)
    return true
end
local function restoreHumanoid(
    humanoid,
    oldWalkSpeed,
    oldAutoRotate,
    oldPlatformStand,
    oldSit
)
    if not humanoid then
        return
    end
    pcall(function()
        humanoid.WalkSpeed =
            oldWalkSpeed
        humanoid.AutoRotate =
            oldAutoRotate
        humanoid.PlatformStand =
            oldPlatformStand
        humanoid.Sit =
            oldSit
    end)
end
local function runMoveTo(
    targetCF,
    speed,
    token
)
    local _, humanoid, root =
        getCharacter()
    if not humanoid or not root then
        return false
    end
    local oldWalkSpeed =
        humanoid.WalkSpeed
    local oldAutoRotate =
        humanoid.AutoRotate
    local oldPlatformStand =
        humanoid.PlatformStand
    local oldSit =
        humanoid.Sit
    humanoid.PlatformStand =
        false
    humanoid.Sit =
        false
    humanoid.AutoRotate =
        true
    humanoid.WalkSpeed =
        math.max(speed, 1)
    local cleanupDone = false
    local function cleanup()
        if cleanupDone then
            return
        end
        cleanupDone = true
        stopHumanoid(humanoid)
        restoreHumanoid(
            humanoid,
            oldWalkSpeed,
            oldAutoRotate,
            oldPlatformStand,
            oldSit
        )
    end
    activeCleanup = cleanup
    local targetPosition =
        targetCF.Position
    local started =
        os.clock()
    local refreshAt =
        0
    while token == movementToken do
        if humanoid.Health <= 0
            or not root.Parent then
            cleanup()
            return false
        end
        local delta =
            targetPosition
            - root.Position
        local horizontal =
            Vector3.new(
                delta.X,
                0,
                delta.Z
            )
        local distance =
            horizontal.Magnitude
        if distance <= 1.1 then
            break
        end
        if os.clock() - started >= 45 then
            cleanup()
            return false
        end
        if os.clock() >= refreshAt then
            humanoid:MoveTo(
                targetPosition
            )
            refreshAt =
                os.clock() + 5
        end
        RunService.Heartbeat:Wait()
    end
    if token ~= movementToken then
        cleanup()
        return false
    end
    stopHumanoid(humanoid)
    restoreHumanoid(
        humanoid,
        oldWalkSpeed,
        oldAutoRotate,
        oldPlatformStand,
        oldSit
    )
    local y =
        root.Position.Y
    root.CFrame =
        CFrame.new(
            targetPosition.X,
            y,
            targetPosition.Z
        )
        * targetCF.Rotation
    zeroVelocity(root)
    cleanup()
    finishMovement(token)
    return true
end
