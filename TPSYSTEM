    velocity.Attachment0 =
        attachment
    velocity.RelativeTo =
        Enum.ActuatorRelativeTo.World
    velocity.VelocityConstraintMode =
        Enum.VelocityConstraintMode.Vector
    velocity.MaxForce =
        math.huge
    velocity.VectorVelocity =
        Vector3.zero
    velocity.Parent =
        root
    local cleanupDone = false
    local function cleanup()
        if cleanupDone then
            return
        end
        cleanupDone = true
        pcall(function()
            velocity:Destroy()
        end)
        pcall(function()
            attachment:Destroy()
        end)
    end
    activeCleanup = cleanup
    local started =
