local function createLanguageButton(code, displayName)
    local LangButton = Instance.new("TextButton", LanguageScroll)
    LangButton.Name = "LanguageButton_" .. code -- ✅ AGREGAR NOMBRE ÚNICO
    LangButton.Size = UDim2.new(1, -12, 0, 32)
    LangButton.Text = displayName
    LangButton.BackgroundColor3 = themeAccentColor
    LangButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    LangButton.Font = Enum.Font.GothamBold
    LangButton.TextSize = 13
    Instance.new("UICorner", LangButton).CornerRadius = UDim.new(0, 8)
    
    registerElementForTheme(LangButton)
    
    if CurrentLanguage == code then
        LangButton.Text = "✓ " .. displayName
    end
    
    LangButton.MouseButton1Click:Connect(function()
        for _, btn in ipairs(LanguageScroll:GetChildren()) do
            if btn:IsA("TextButton") then
                local btnText = btn.Text:gsub("✓ ", "")
                btn.Text = btnText
            end
        end
        
        LangButton.Text = "✓ " .. displayName
        ThemeFrame.Visible = false
        
        JmodsLib:Notify({
            Title = "Traduciendo interfaz...",
            Content = "Por favor espera mientras traducimos todos los elementos a " .. displayName,
            Duration = 3
        })
        
        task.spawn(function()
            translateInterface(code)
            wait(2)
            JmodsLib:Notify({
                Title = "Traducción completada",
                Content = "Idioma cambiado a: " .. displayName .. "\n¡Guardado automáticamente!",
                Duration = 4
            })
        end)
    end)
    
    return LangButton
end

