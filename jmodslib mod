    function FloatingObj:CreateToggle(opts)
        opts = opts or {}
        local ToggleFrame = Instance.new("Frame", FloatPage)
        ToggleFrame.Name = "ToggleFrame"
        ToggleFrame.Size = UDim2.new(1, -4, 0, 38)
        ToggleFrame.BackgroundColor3 = inputColor
        Instance.new("UICorner", ToggleFrame).CornerRadius = UDim.new(0, 8)

        local Title = Instance.new("TextLabel", ToggleFrame)
        Title.Size = UDim2.new(0.65, 0, 1, 0)
        Title.Position = UDim2.new(0, 10, 0, 0)
        Title.Text = opts.Name or "Toggle"
        Title.TextColor3 = Color3.fromRGB(240,240,240)
        Title.Font = Enum.Font.Gotham
        Title.TextSize = 13
        Title.BackgroundTransparency = 1
        Title.TextXAlignment = Enum.TextXAlignment.Left

        local SwitchBack = Instance.new("Frame", ToggleFrame)
        SwitchBack.Name = "SwitchBack"
        SwitchBack.Size = UDim2.new(0, 44, 0, 18)
        SwitchBack.Position = UDim2.new(1, -54, 0.5, -9)
        SwitchBack.BackgroundColor3 = baseColor:Lerp(accentColor, 0.22)
        Instance.new("UICorner", SwitchBack).CornerRadius = UDim.new(0, 6)

        local Handle = Instance.new("Frame", SwitchBack)
        Handle.Name = "Handle"
        Handle.Size = UDim2.new(0, 16, 0, 16)
        Handle.Position = UDim2.new(0, 1, 0.5, -8)
        Handle.BackgroundColor3 = Color3.fromRGB(200,200,200)
        Instance.new("UICorner", Handle).CornerRadius = UDim.new(0, 4)

        local state = opts.CurrentValue or false
        local function updateVisual()
            if state then
                TweenService:Create(Handle, TweenInfo.new(0.12), {Position = UDim2.new(1, -17, 0.5, -8)}):Play()
                TweenService:Create(SwitchBack, TweenInfo.new(0.12), {BackgroundColor3 = accentColor}):Play()
            else
                TweenService:Create(Handle, TweenInfo.new(0.12), {Position = UDim2.new(0, 1, 0.5, -8)}):Play()
                TweenService:Create(SwitchBack, TweenInfo.new(0.12), {BackgroundColor3 = baseColor:Lerp(accentColor, 0.22)}):Play()
            end
        end
        updateVisual()

        SwitchBack.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                state = not state
                updateVisual()
                if opts.Callback then pcall(opts.Callback, state) end
            end
        end)

        return ToggleFrame
    end

    function FloatingObj:CreateSlider(opts)
        opts = opts or {}
        local Frame = Instance.new("Frame", FloatPage)
        Frame.Name = "Slider"
        Frame.Size = UDim2.new(1, -4, 0, 46)
        Frame.BackgroundColor3 = inputColor
        Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 8)

        local Title = Instance.new("TextLabel", Frame)
        Title.Size = UDim2.new(1, -70, 0, 18)
        Title.Position = UDim2.new(0, 10, 0, 4)
        Title.Text = opts.Name or "Slider"
        Title.TextColor3 = Color3.fromRGB(240,240,240)
        Title.Font = Enum.Font.Gotham
        Title.TextSize = 13
        Title.BackgroundTransparency = 1
        Title.TextXAlignment = Enum.TextXAlignment.Left

        local ValueLabel = Instance.new("TextLabel", Frame)
        ValueLabel.Size = UDim2.new(0, 60, 0, 18)
        ValueLabel.Position = UDim2.new(1, -68, 0, 4)
        ValueLabel.TextColor3 = Color3.fromRGB(255,255,255)
        ValueLabel.Font = Enum.Font.Gotham
        ValueLabel.TextSize = 12
        ValueLabel.BackgroundTransparency = 1

        local SliderBack = Instance.new("Frame", Frame)
        SliderBack.Name = "SliderBack"
        SliderBack.Size = UDim2.new(1, -20, 0, 8)
        SliderBack.Position = UDim2.new(0, 10, 0, 28)
        SliderBack.BackgroundColor3 = baseColor:Lerp(accentColor, 0.25)
        Instance.new("UICorner", SliderBack).CornerRadius = UDim.new(1,0)

        local Fill = Instance.new("Frame", SliderBack)
        Fill.Name = "Fill"
        Fill.Size = UDim2.new(0,0,1,0)
        Fill.BackgroundColor3 = accentColor
        Instance.new("UICorner", Fill).CornerRadius = UDim.new(1,0)

        local Handle = Instance.new("Frame", SliderBack)
        Handle.Name = "Handle"
        Handle.Size = UDim2.new(0, 12, 0, 12)
        Handle.AnchorPoint = Vector2.new(0.5, 0.5)
        Handle.Position = UDim2.new(0, 0, 0.5, 0)
        Handle.BackgroundColor3 = Color3.fromRGB(255,255,255)
        Instance.new("UICorner", Handle).CornerRadius = UDim.new(1,0)
        Handle.ZIndex = SliderBack.ZIndex + 1

        local min = (opts.Range and opts.Range[1]) or 0
        local max = (opts.Range and opts.Range[2]) or 100
        local val = opts.CurrentValue or min

        local function setValue(newVal)
            local increment = opts.Increment or 1
            newVal = math.clamp(newVal, min, max)
            local stepped = math.floor(newVal / increment + 0.5) * increment
            val = stepped
            local percent = (val - min) / (max - min)
            Fill.Size = UDim2.new(percent, 0, 1, 0)
            Handle.Position = UDim2.new(percent, 0, 0.5, 0)
            ValueLabel.Text = tostring(val) .. " " .. (opts.Suffix or "")
            if opts.Callback then pcall(opts.Callback, val) end
        end

        local dragging = false
        local function startDrag(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                local pos = math.clamp((input.Position.X - SliderBack.AbsolutePosition.X) / SliderBack.AbsoluteSize.X, 0, 1)
                setValue(min + (max-min)*pos)
            end
        end
        SliderBack.InputBegan:Connect(startDrag)
        Handle.InputBegan:Connect(startDrag)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local pos = math.clamp((input.Position.X - SliderBack.AbsolutePosition.X) / SliderBack.AbsoluteSize.X, 0, 1)
                setValue(min + (max-min)*pos)
            end
        end)

        setValue(val)
        return Frame
    end

    function FloatingObj:CreateInput(opts)
        opts = opts or {}
        local hasLabel = opts.Name ~= nil
        local InputFrame = Instance.new("Frame", FloatPage)
        InputFrame.BackgroundTransparency = 1
        InputFrame.Size = UDim2.new(1, -4, 0, hasLabel and 58 or 34)

        local NameLabel
        if hasLabel then
            NameLabel = Instance.new("TextLabel", InputFrame)
            NameLabel.Size = UDim2.new(1, 0, 0, 18)
            NameLabel.Text = opts.Name
            NameLabel.TextColor3 = Color3.fromRGB(240,240,240)
            NameLabel.Font = Enum.Font.Gotham
            NameLabel.TextSize = 13
            NameLabel.BackgroundTransparency = 1
            NameLabel.TextXAlignment = Enum.TextXAlignment.Left
        end

        local InputBox = Instance.new("TextBox", InputFrame)
