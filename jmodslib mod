    -- ✅ FUNCIÓN CORREGIDA: detectar links sin usar patrones complejos
-- Reemplaza desde línea ~1530
local linkCache = {} -- Caché global

local function detectLinks(text)
    -- Verificación rápida: si no tiene "://" ni "www.", salir inmediatamente
    if not text:find("://") and not text:find("www%.") then
        return {}
    end
    
    -- Verificar caché
    if linkCache[text] then
        return linkCache[text]
    end
    
    local links = {}
    local maxLinks = 2 -- Reducir de 3 a 2
    
    -- Buscar solo una vez con patrón optimizado
    for link in text:gmatch("https?://[%w%.%-_~:/?#%[%]@!$&'%(%)%*%+,;=%%]+") do
        if #links >= maxLinks then break end
        table.insert(links, link)
    end
    
    -- Guardar en caché (máximo 20 entradas)
    if #linkCache > 20 then
        linkCache = {}
    end
    linkCache[text] = links
    
    return links
end

    -- ✅ FUNCIÓN MEJORADA: obtener nombre corto
    local function getShortName(url)
        -- Eliminar protocolo
        local cleanUrl = url:gsub("^https?://", ""):gsub("^www%.", "")
        
        -- Obtener solo el dominio principal
        local domain = cleanUrl:match("([^/]+)") or cleanUrl
        domain = domain:lower()
        
        -- Mapeo de dominios conocidos
        local shortNames = {
            ["youtube.com"] = "YouTube",
            ["youtu.be"] = "YouTube",
            ["tiktok.com"] = "TikTok",
            ["twitter.com"] = "Twitter",
            ["x.com"] = "Twitter",
            ["facebook.com"] = "Facebook",
            ["instagram.com"] = "Instagram",
            ["discord.com"] = "Discord",
            ["github.com"] = "GitHub",
            ["reddit.com"] = "Reddit",
            ["twitch.tv"] = "Twitch",
            ["roblox.com"] = "Roblox"
        }
        
        -- Buscar coincidencia exacta
        for pattern, name in pairs(shortNames) do
            if domain:find(pattern, 1, true) then
                return name
            end
        end
        
        -- Extraer nombre principal del dominio
        local mainDomain = domain:match("([^%.]+)%.")
        if mainDomain then
            return mainDomain:sub(1,1):upper() .. mainDomain:sub(2)
        end
        
        return domain
    end

    -- ✅ FUNCIÓN CORREGIDA: copiar al portapapeles
    local function copyToClipboard(text)
        pcall(function()
            if setclipboard then
                setclipboard(text)
            end
        end)
    end

    -- Crear frame principal
    local Frame = Instance.new("Frame", ScreenGui)
    Frame.Name = "NotificationFrame"

    if UserInputService.TouchEnabled then
        Frame.Size = UDim2.new(0, 280, 0, 70)
    else
        Frame.Size = UDim2.new(0, 340, 0, 85)
    end

Frame.Position = UDim2.new(1, -360, 0, -15)
----NOtificion lugar
    Frame.BackgroundColor3 = theme.Accent or Color3.fromRGB(50, 50, 80)
    Frame.BackgroundTransparency = 0.1
    Frame.BorderSizePixel = 0
    Instance.new("UICorner", Frame).CornerRadius = UDim.new(0, 12)

    -- Título
    local Title = Instance.new("TextLabel", Frame)
    Title.Name = "Title"
    Title.Size = UDim2.new(1, -16, 0, 20)
    Title.Position = UDim2.new(0, 8, 0, 6)
    Title.Text = options.Title or "Notificación"
    Title.Font = Enum.Font.GothamBold
    Title.TextSize = 15
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.BackgroundTransparency = 1
    Title.TextXAlignment = Enum.TextXAlignment.Left

    -- Imagen (si se proporciona)
    if options.Image then
        local ImageLabel = Instance.new("ImageLabel", Frame)
        ImageLabel.Size = UDim2.new(0, 24, 0, 24)
        ImageLabel.Position = UDim2.new(1, -32, 0, 6)
        ImageLabel.BackgroundTransparency = 1
        ImageLabel.Image = "rbxassetid://" .. tostring(options.Image)
        ImageLabel.ScaleType = Enum.ScaleType.Fit
        Instance.new("UICorner", ImageLabel).CornerRadius = UDim.new(0, 4)
    end

    -- Separador
    local Separator = Instance.new("Frame", Frame)
    Separator.Size = UDim2.new(1, -16, 0, 1)
    Separator.Position = UDim2.new(0, 8, 0, 28)
    Separator.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Separator.BorderSizePixel = 0
    Separator.BackgroundTransparency = 0.7

    -- ✅ PROCESAMIENTO CORREGIDO: contenido con links
    local contentText = options.Content or ""
    local links = detectLinks(contentText)

    -- Contenedor del contenido
    local ContentFrame = Instance.new("Frame", Frame)
    ContentFrame.Size = UDim2.new(1, -16, 1, -38)
    ContentFrame.Position = UDim2.new(0, 8, 0, 32)
    ContentFrame.BackgroundTransparency = 1

    if #links > 0 then
        -- ✅ SOLUCIÓN: Dividir el texto en partes (texto + link + texto)
        local parts = {}
        local lastPos = 1
        
        for _, link in ipairs(links) do
            local startPos, endPos = contentText:find(link, lastPos, true)
            if startPos then
                -- Texto antes del link
                if startPos > lastPos then
                    table.insert(parts, {type = "text", content = contentText:sub(lastPos, startPos - 1)})
                end
                -- El link
                table.insert(parts, {type = "link", content = link})
                lastPos = endPos + 1
            end
        end
        
        -- Texto después del último link
        if lastPos <= #contentText then
            table.insert(parts, {type = "text", content = contentText:sub(lastPos)})
        end

        -- Crear elementos visuales
        local yOffset = 0
        
        for i, part in ipairs(parts) do
            if part.type == "text" then
                local TextLabel = Instance.new("TextLabel", ContentFrame)
                TextLabel.Size = UDim2.new(1, 0, 0, 16)
                TextLabel.Position = UDim2.new(0, 0, 0, yOffset)
                TextLabel.Text = part.content
                TextLabel.Font = Enum.Font.Gotham
                TextLabel.TextSize = 13
                TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                TextLabel.BackgroundTransparency = 1
                TextLabel.TextXAlignment = Enum.TextXAlignment.Left
                TextLabel.TextYAlignment = Enum.TextYAlignment.Top
                TextLabel.TextWrapped = true
                yOffset = yOffset + 16
                
            elseif part.type == "link" then
                local LinkButton = Instance.new("TextButton", ContentFrame)
                LinkButton.Size = UDim2.new(1, 0, 0, 18)
                LinkButton.Position = UDim2.new(0, 0, 0, yOffset)
                LinkButton.Text = "🔗 " .. getShortName(part.content)
                LinkButton.Font = Enum.Font.GothamBold
                LinkButton.TextSize = 13
                LinkButton.TextColor3 = Color3.fromRGB(100, 200, 255)
                LinkButton.BackgroundTransparency = 1
                LinkButton.TextXAlignment = Enum.TextXAlignment.Left
                LinkButton.AutoButtonColor = false
                
                -- Subrayado
                local Underline = Instance.new("Frame", LinkButton)
                Underline.Size = UDim2.new(0, LinkButton.TextBounds.X + 20, 0, 1)
                Underline.Position = UDim2.new(0, 0, 1, -2)
                Underline.BackgroundColor3 = Color3.fromRGB(100, 200, 255)
                Underline.BorderSizePixel = 0
                
                -- Hover effect
                LinkButton.MouseEnter:Connect(function()
                    LinkButton.TextColor3 = Color3.fromRGB(150, 220, 255)
                    Underline.BackgroundColor3 = Color3.fromRGB(150, 220, 255)
                end)
                
                LinkButton.MouseLeave:Connect(function()
                    LinkButton.TextColor3 = Color3.fromRGB(100, 200, 255)
                    Underline.BackgroundColor3 = Color3.fromRGB(100, 200, 255)
                end)
                
                -- Click para copiar
                LinkButton.MouseButton1Click:Connect(function()
                    copyToClipboard(part.content)
                    LinkButton.Text = "✓ Copiado"
                    wait(1)
                    LinkButton.Text = "🔗 " .. getShortName(part.content)
                end)
                
                yOffset = yOffset + 18
            end
        end
        
    else
        -- Sin links, texto normal
        local Content = Instance.new("TextLabel", ContentFrame)
        Content.Size = UDim2.new(1, 0, 1, 0)
        Content.Text = contentText
        Content.Font = Enum.Font.Gotham
        Content.TextSize = 13
        Content.TextColor3 = Color3.fromRGB(255, 255, 255)
        Content.BackgroundTransparency = 1
        Content.TextXAlignment = Enum.TextXAlignment.Left
        Content.TextYAlignment = Enum.TextYAlignment.Top
        Content.TextWrapped = true
    end

    -- Guardar referencia
    LastNotification = Frame

    -- Animación de entrada
    local TweenService = game:GetService("TweenService")
    local targetPos = Frame.Position
    Frame.Position = UDim2.new(1, 20, targetPos.Y.Scale, targetPos.Y.Offset)
    TweenService:Create(Frame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {Position = targetPos}):Play()

    -- Auto-cerrar
    local duration = options.Duration or 5
    task.spawn(function()
        wait(duration)
        pcall(function()
            if LastNotification == Frame then
                local endPos = UDim2.new(1, 20, Frame.Position.Y.Scale, Frame.Position.Y.Offset)
                TweenService:Create(Frame, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = endPos, BackgroundTransparency = 1}):Play()
                wait(0.28)
                if Frame and Frame.Parent then Frame:Destroy() end
                if LastNotification == Frame then LastNotification = nil end
            else
                if Frame and Frame.Parent then Frame:Destroy() end
            end
        end)
        if options.Callback then pcall(options.Callback) end
    end)
end



