-- ✅ NUEVO: Almacenar texto original en español
local OriginalTexts = {}

local function storeOriginalText(obj)
    if not OriginalTexts[obj] then
        if obj:IsA("TextLabel") or obj:IsA("TextButton") then
            OriginalTexts[obj] = obj.Text
        elseif obj:IsA("TextBox") then
            OriginalTexts[obj] = {
                Text = obj.Text,
                Placeholder = obj.PlaceholderText
            }
        end
    end
end


-- FUNCIÓN DE TRADUCCIÓN
local function translateText(text, targetLang, sourceText)
    if not text or text == "" then return text end
    
    -- ✅ Si el idioma destino es español, retornar el texto original
    if targetLang == "es" then
        return sourceText or text
    end
    
    -- ✅ Usar sourceText (español) como base si está disponible
    local textToTranslate = sourceText or text
    
    local cacheKey = textToTranslate .. "_" .. targetLang
    if TranslationCache[cacheKey] then
        return TranslationCache[cacheKey]
    end
    
    local url = string.format(
        "https://translate.googleapis.com/translate_a/single?client=gtx&sl=es&tl=%s&dt=t&q=%s",
        targetLang,
        game:GetService("HttpService"):UrlEncode(textToTranslate)
    )
    
    local success, result = pcall(function()
        local req = (syn and syn.request) or http_request or request
        local response = req({
            Url = url,
            Method = "GET"
        })
        
        if response and response.Body then
            local decoded = game:GetService("HttpService"):JSONDecode(response.Body)
            if decoded and decoded[1] and decoded[1][1] and decoded[1][1][1] then
                return decoded[1][1][1]
            end
        end
        return textToTranslate
    end)
    
    if success and result then
        TranslationCache[cacheKey] = result
        return result
    end
    
    return textToTranslate
end

local function translateInterface(targetLang)
    if not targetLang then return end
    
    local coreGui = CONTAINER
    local attempts = 0
    local maxAttempts = 10
    
    -- Esperar hasta que haya elementos para traducir
    while attempts < maxAttempts do
        local found = false
        for _, gui in ipairs(coreGui:GetChildren()) do
            if gui:IsA("ScreenGui") then
                local mainFrame = gui:FindFirstChild("MainFrame")
                if mainFrame and #mainFrame:GetDescendants() > 10 then
                    found = true
                    break
                end
            end
        end
        
        if found then break end
        attempts = attempts + 1
        task.wait(0.2)
    end
    
    print("🔄 Traduciendo interfaz a: " .. targetLang)
    
    for _, gui in ipairs(coreGui:GetChildren()) do
        if gui:IsA("ScreenGui") then
            local mainFrame = gui:FindFirstChild("MainFrame")
            if mainFrame then
                for _, obj in ipairs(mainFrame:GetDescendants()) do
                    pcall(function()
                        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
                            if obj.Text and obj.Text ~= "" and not tonumber(obj.Text) then
                                if obj.Name ~= "ValueLabel" and obj.Name ~= "KeyButton" then
                                    -- ✅ Guardar texto original si no existe
                                    storeOriginalText(obj)
                                    
                                    local originalText = OriginalTexts[obj]
                                    if originalText then
                                        task.spawn(function()
                                            local translated = translateText(obj.Text, targetLang, originalText)
                                            if translated then
                                                obj.Text = translated
                                            end
                                        end)
                                    end
                                end
                            end
                            
                            -- ✅ Traducir placeholder
                            if obj:IsA("TextBox") and obj.PlaceholderText and obj.PlaceholderText ~= "" then
                                storeOriginalText(obj)
                                local originalData = OriginalTexts[obj]
                                if originalData and originalData.Placeholder then
                                    task.spawn(function()
                                        local translated = translateText(obj.PlaceholderText, targetLang, originalData.Placeholder)
                                        if translated then
                                            obj.PlaceholderText = translated
                                        end
                                    end)
                                end
                            end
                        end
                    end)
                end
            end
        end
    end
    
    -- ✅ ACTUALIZAR CurrentLanguage AL FINAL
    CurrentLanguage = targetLang
    saveLanguage(targetLang)
    print("✅ Traducción completada a: " .. targetLang)
end


