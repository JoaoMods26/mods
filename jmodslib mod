        local targetHeight = math.min(#currentOptions * 34, 195)

        TweenService:Create(ListFrame, TweenInfo.new(0.18), {
            Size = UDim2.new(1,0,0,targetHeight)
        }):Play()
        
        local page = Container:FindFirstAncestorWhichIsA("ScrollingFrame")
        if page then
            local layout = page:FindFirstChildOfClass("UIListLayout")
            if layout then
                task.wait(0.2)
                page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + targetHeight + 20)
            end
        end
    end

    local function close()
        if not isOpen then return end
        isOpen = false
        
        for i, dd in ipairs(OpenDropdowns) do
            if dd == ListFrame then
                table.remove(OpenDropdowns, i)
                break
            end
        end
        
        TweenService:Create(Arrow, TweenInfo.new(0.18), {Rotation = 0}):Play()
        TweenService:Create(ListFrame, TweenInfo.new(0.18), {
            Size = UDim2.new(1,0,0,0)
        }):Play()
        
        task.wait(0.2)
        if #OpenDropdowns == 0 then
            local page = Container:FindFirstAncestorWhichIsA("ScrollingFrame")
            if page then
                local layout = page:FindFirstChildOfClass("UIListLayout")
                if layout then
                    page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
                end
            end
        end
    end

    local function selectOption(text)
        selected = text
        Label.Text = text
        if options.Callback then
            pcall(function() options.Callback(text) end)
        end
    end

    -- ✅ FUNCIÓN PARA CREAR BOTONES DE OPCIONES
    local function createOptionButton(opt, index)
        local optBtn = Instance.new("TextButton", Scroll)
        optBtn.Name = "DropdownOption_" .. index -- ✅ NOMBRE ÚNICO
        optBtn.Size = UDim2.new(1, -6, 0, 32)
        optBtn.BackgroundColor3 = (JmodsLib and JmodsLib.Theme and JmodsLib.Theme.Input) or Color3.fromRGB(40,40,40)
        optBtn.BorderSizePixel = 0
        optBtn.Text = opt
        optBtn.TextColor3 = Color3.fromRGB(240,240,240)
        optBtn.Font = Enum.Font.Gotham
        optBtn.TextSize = 14
        optBtn.AutoButtonColor = false
        optBtn.LayoutOrder = index
        optBtn.ZIndex = 12
        Instance.new("UICorner", optBtn).CornerRadius = UDim.new(0, 8)

        optBtn.MouseEnter:Connect(function()
            pcall(function() optBtn:TweenSize(UDim2.new(1, -2, 0, 34), "Out", "Quad", 0.12, true) end)
        end)
        optBtn.MouseLeave:Connect(function()
            pcall(function() optBtn:TweenSize(UDim2.new(1, -6, 0, 32), "Out", "Quad", 0.12, true) end)
        end)
        optBtn.MouseButton1Click:Connect(function()
            selectOption(opt)
            close()
        end)
        
        -- ✅ REGISTRAR PARA TEMAS
        registerElementForTheme(optBtn)
        
        return optBtn
    end

    -- ✅ CREAR OPCIONES INICIALES
    for i, opt in ipairs(currentOptions) do
        createOptionButton(opt, i)
    end

    DropButton.MouseButton1Click:Connect(function()
        if isOpen then close() else open() end
    end)

    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 and isOpen then
            local mouseLoc = UIS:GetMouseLocation()
            local absPos = Container.AbsolutePosition
            local absSize = Container.AbsoluteSize + Vector2.new(0, ListFrame.AbsoluteSize.Y)
            if mouseLoc.X < absPos.X or mouseLoc.X > absPos.X + absSize.X or mouseLoc.Y < absPos.Y or mouseLoc.Y > absPos.Y + absSize.Y then
                close()
            end
        end
    end)

    registerElementForTheme(Container)
    registerElementForTheme(DropdownFrame)
    registerElementForTheme(ListFrame)
    registerElementForTheme(TitleLabel)
    registerElementForTheme(DropButton)

    -- ✅ OBJETO RETORNADO CON MÉTODOS
    local DropdownObj = {}
    
    function DropdownObj:Set(value)
        selectOption(value)
    end
    
    function DropdownObj:Get()
        return selected
    end
    
-- ✅ MÉTODO ORIGINAL: UpdateOptions (actualiza inmediatamente)
    function DropdownObj:UpdateOptions(newOptions)
        if not newOptions or type(newOptions) ~= "table" then return end
        
        -- Actualizar lista de opciones
        currentOptions = newOptions
        
        -- Cerrar dropdown si está abierto
        if isOpen then close() end
        
        -- Limpiar opciones anteriores
        for _, child in ipairs(Scroll:GetChildren()) do
            if child:IsA("TextButton") and child.Name:find("DropdownOption_") then
                child:Destroy()
            end
        end
        
        -- Crear nuevas opciones
        for i, opt in ipairs(newOptions) do
            createOptionButton(opt, i)
        end
        
        -- Si la selección actual ya no existe, resetear
        local stillExists = false
        for _, opt in ipairs(newOptions) do
            if opt == selected then
                stillExists = true
                break
            end
        end
        
        if not stillExists and #newOptions > 0 then
            selectOption(newOptions[1])
        elseif #newOptions == 0 then
            Label.Text = "Sin opciones"
            selected = nil
        end
    end
    
    -- ✅ NUEVO MÉTODO: UpdateOnClose (actualiza solo al cerrar)
    local pendingUpdate = nil
    
    function DropdownObj:UpdateOnClose(newOptions)
        if not newOptions or type(newOptions) ~= "table" then return end
        pendingUpdate = newOptions
    end
    
    -- ✅ MODIFICAR función close para aplicar actualizaciones pendientes
    local originalClose = close
    close = function()
        originalClose() -- Ejecutar cierre normal
        
        -- Aplicar actualización pendiente si existe
        if pendingUpdate then
            task.defer(function()
                local newOptions = pendingUpdate
                pendingUpdate = nil
                
                currentOptions = newOptions
                
                for _, child in ipairs(Scroll:GetChildren()) do
                    if child:IsA("TextButton") and child.Name:find("DropdownOption_") then
                        child:Destroy()
                    end
                end
                
                for i, opt in ipairs(newOptions) do
                    createOptionButton(opt, i)
                end
                
                local stillExists = false
                for _, opt in ipairs(newOptions) do
                    if opt == selected then
                        stillExists = true
                        break
                    end
                end
                
                if not stillExists and #newOptions > 0 then
                    selectOption(newOptions[1])
                elseif #newOptions == 0 then
                    Label.Text = "Sin opciones"
                    selected = nil
                end
            end)
        end
    end

    return DropdownObj
end

    -- ============================================================
    -- HELPER INTERNO: normalizar AssetId a string rbxassetid://
    -- ============================================================
    local function _toAsset(id)
        if type(id) == "number" then
            return "rbxassetid://" .. tostring(id)
        end
        local s = tostring(id or 0)
        if s:find("rbxassetid://") then return s end
        return "rbxassetid://" .. s
    end

    -- HELPER INTERNO: obtener color del tema actual (accent o base lerp)
    local function _themeColor(mode)
        local t = JmodsLib.Theme or {
            Base   = Color3.fromRGB(25, 25, 35),
            Accent = Color3.fromRGB(70, 70, 120),
            Input  = Color3.fromRGB(50, 50, 80),
        }
        if mode == "accent" then return t.Accent end
        if mode == "input"  then return t.Input  end
        -- "card" = fondo tipo Paragraph/Slider (Lerp 40% accent->base)
        return t.Accent:Lerp(t.Base, 0.6)
    end

    -- ============================================================
    -- CreateImage  — imagen sola, con fondo del tema y alineación
    -- ============================================================
    -- Opciones:
    --   Image        = 12453664        AssetId (número o string)
    --   PlayerImage  = true/false      Si true, carga thumbnail del jugador (UserId en Image)
    --   Size         = 64              Px cuadrado (default 64)
    --   Align        = "Center"        "Left" | "Center" | "Right"
    --   CornerRadius = 8
    --   Background   = true/false      Mostrar fondo con color del tema (default true)
    -- ----------------------------------------------------------------
    -- Métodos:
    --   :SetImage(id)                  Cambia la imagen (assetId o string)
    --   :SetPlayerThumbnail(userId)    Carga avatar del jugador
    -- ============================================================
    function TabObj:CreateImage(options)
        options = options or {}

        local imgSize  = options.Size or 64
        local align    = (options.Align or options.Posicion or "Center"):lower()
        local radius   = options.CornerRadius or 8
        local rawId    = options.Image or options.ImageId or 0
        local showBg   = options.Background ~= false

        -- Fila invisible de ancho completo (para que el UIListLayout del Page lo coloque bien)
        local RowFrame = Instance.new("Frame", Page)
        RowFrame.Name             = "ImageWrapperRow"
        RowFrame.Size             = UDim2.new(1, -12, 0, imgSize + 16)
        RowFrame.BackgroundTransparency = 1
        RowFrame.LayoutOrder      = #(Page:GetChildren())

        -- Fondo pequeño centrado/alineado dentro de la fila
        local Wrapper = Instance.new("Frame", RowFrame)
        Wrapper.Name = "ImageWrapper"
        Wrapper.Size = UDim2.new(0, imgSize + 16, 0, imgSize + 16)

        if align == "left" then
            Wrapper.AnchorPoint = Vector2.new(0, 0.5)
            Wrapper.Position    = UDim2.new(0, 0, 0.5, 0)
        elseif align == "right" then
            Wrapper.AnchorPoint = Vector2.new(1, 0.5)
            Wrapper.Position    = UDim2.new(1, 0, 0.5, 0)
        else
            Wrapper.AnchorPoint = Vector2.new(0.5, 0.5)
            Wrapper.Position    = UDim2.new(0.5, 0, 0.5, 0)
        end

        if showBg then
            Wrapper.BackgroundColor3 = _themeColor("card")
            Instance.new("UICorner", Wrapper).CornerRadius = UDim.new(0, 8)
        else
            Wrapper.BackgroundTransparency = 1
        end

        -- ImageLabel centrada dentro del Wrapper
        local Img = Instance.new("ImageLabel", Wrapper)
        Img.Name        = "ImageLabel"
        Img.AnchorPoint = Vector2.new(0.5, 0.5)
        Img.Position    = UDim2.new(0.5, 0, 0.5, 0)
        Img.Size        = UDim2.new(0, imgSize, 0, imgSize)
        Img.BackgroundTransparency = 1
        Img.ScaleType   = Enum.ScaleType.Fit
        Img.Image       = _toAsset(rawId)
        Instance.new("UICorner", Img).CornerRadius = UDim.new(0, radius)

        -- Registrar Wrapper para que applyThemeToElement lo coloree (name = "ImageWrapper")
        registerElementForTheme(Wrapper)

        -- Cargar thumbnail si se pidió
        if options.PlayerImage and rawId ~= 0 then
            task.spawn(function()
                pcall(function()
                    local thumb = game:GetService("Players"):GetUserThumbnailAsync(
                        tonumber(rawId), Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                    if Img and Img.Parent then Img.Image = thumb end
                end)
            end)
        end

        local ImageObj = {}

        function ImageObj:SetImage(newId)
            if Img and Img.Parent then Img.Image = _toAsset(newId) end
        end

        function ImageObj:SetPlayerThumbnail(userId)
            task.spawn(function()
                pcall(function()
                    local thumb = game:GetService("Players"):GetUserThumbnailAsync(
                        tonumber(userId), Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
                    if Img and Img.Parent then Img.Image = thumb end
                end)
            end)
        end

        function ImageObj:GetFrame() return RowFrame end

        return ImageObj
    end


    -- ============================================================
    -- CreateImageRow  — imagen izquierda + texto/info derecha
    -- ============================================================
    -- Opciones:
    --   Image        = 12453664        AssetId o UserId (número o string)
    --   PlayerImage  = true/false      Si true, carga thumbnail del jugador (Image = UserId)
    --   ImgSize      = 56              Px cuadrado imagen (default 56)
    --   Height       = 74              Altura total (default ImgSize + 18)
    --   Spacing      = 10              Gap imagen↔texto (default 10)
    --   CornerRadius = 8
    --   Title        = "Nombre"
    --   Content      = "Descripción"
    -- ----------------------------------------------------------------
    -- Métodos:
    --   :SetImage(id)
    --   :SetPlayerThumbnail(userId)
    --   :UpdateTitle(text)
    --   :UpdateContent(text)
    --   :GetFrame()
    --   :GetContentArea()   → Frame donde puedes meter hijos extra
    -- ============================================================
function TabObj:CreateImageRow(options)
    options = options or {}

    local imgSize = options.ImgSize or options.Size or 56
    local spacing = options.Spacing or 10
    local radius  = options.CornerRadius or 8
    local rawId   = options.Image or options.ImageId or 0

    -- Fondo card
    local Row = Instance.new("Frame", Page)
    Row.Name  = "ImageRow"
    Row.Size  = UDim2.new(1, -12, 0, imgSize + 18)
    Row.BackgroundColor3 = _themeColor("card")
    Row.LayoutOrder = #(Page:GetChildren())
    Row.ClipsDescendants = false
    Instance.new("UICorner", Row).CornerRadius = UDim.new(0, 8)

    -- Imagen izquierda (fija arriba-izquierda)
    local Img = Instance.new("ImageLabel", Row)
    Img.Name            = "ImageLabel"
    Img.AnchorPoint     = Vector2.new(0, 0)
    Img.Position        = UDim2.new(0, 7, 0, 9)
    Img.Size            = UDim2.new(0, imgSize, 0, imgSize)
    Img.BackgroundTransparency = 1
    Img.Image           = _toAsset(rawId)
    Img.ScaleType       = Enum.ScaleType.Fit
    Instance.new("UICorner", Img).CornerRadius = UDim.new(0, radius)

    -- Zona de contenido derecha
    local rightX = imgSize + 7 + spacing

    -- Título
    local TitleLabel = Instance.new("TextLabel", Row)
    TitleLabel.Name             = "Title"
    TitleLabel.AnchorPoint      = Vector2.new(0, 0)
    TitleLabel.Position         = UDim2.new(0, rightX, 0, 8)
    TitleLabel.Size             = UDim2.new(1, -(rightX + 10), 0, 18)
    TitleLabel.Text             = options.Title or ""
    TitleLabel.Font             = Enum.Font.GothamBold
    TitleLabel.TextSize         = 14
    TitleLabel.TextColor3       = Color3.fromRGB(245, 245, 245)
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.TextXAlignment   = Enum.TextXAlignment.Left
    TitleLabel.TextTruncate     = Enum.TextTruncate.AtEnd

    -- Separador fino debajo del título
    local Sep = Instance.new("Frame", Row)
    Sep.AnchorPoint       = Vector2.new(0, 0)
    Sep.Position          = UDim2.new(0, rightX, 0, 29)
    Sep.Size              = UDim2.new(1, -(rightX + 10), 0, 1)
    Sep.BorderSizePixel   = 0
    Sep.BackgroundColor3  = Color3.fromRGB(80, 80, 100)
    Sep.BackgroundTransparency = 0.4

    -- Contenido (TextLabel con AutomaticSize vertical)
    local ContentLabel = Instance.new("TextLabel", Row)
    ContentLabel.Name             = "Content"
    ContentLabel.AnchorPoint      = Vector2.new(0, 0)
    ContentLabel.Position         = UDim2.new(0, rightX, 0, 33)
    -- ✅ CLAVE: ancho fijo calculado, alto = 0 para que AutomaticSize lo maneje
    ContentLabel.Size             = UDim2.new(1, -(rightX + 10), 0, 0)
    ContentLabel.AutomaticSize    = Enum.AutomaticSize.Y  -- ← ESTO es lo que faltaba
    ContentLabel.Text             = options.Content or ""
    ContentLabel.Font             = Enum.Font.Gotham
    ContentLabel.TextSize         = 12
    ContentLabel.TextColor3       = Color3.fromRGB(190, 190, 210)
    ContentLabel.BackgroundTransparency = 1
    ContentLabel.TextXAlignment   = Enum.TextXAlignment.Left
    ContentLabel.TextYAlignment   = Enum.TextYAlignment.Top
    ContentLabel.TextWrapped      = true
    ContentLabel.RichText         = false

    -- ✅ FUNCIÓN DE AJUSTE: usa AbsoluteSize real del ContentLabel después de AutomaticSize
    local TextService = game:GetService("TextService")

    local function updateHeight()
        -- Esperar a que el Row tenga ancho real
        local rowW = Row.AbsoluteSize.X
        if rowW <= 10 then return end

        local availW = rowW - rightX - 10
        if availW <= 0 then return end

        local txt = ContentLabel.Text
        local textH = 0
        if txt ~= "" then
            local ok, size = pcall(function()
                return TextService:GetTextSize(
                    txt,
                    ContentLabel.TextSize,
                    ContentLabel.Font,
                    Vector2.new(availW, math.huge)
                )
            end)
            if ok then textH = size.Y end
        end

        -- totalHeight = padding_top(8) + titulo(18) + gap(3) + sep(1) + gap(3) + texto + padding_bottom(10)
        local totalHeight = math.max(imgSize + 18, 8 + 18 + 3 + 1 + 3 + textH + 10)
        Row.Size = UDim2.new(1, -12, 0, totalHeight)

        -- Actualizar CanvasSize del Page
        local layout = Page:FindFirstChildOfClass("UIListLayout")
        if layout then
            Page.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 10)
        end
    end

    -- ✅ Disparar updateHeight cuando el Row ya tenga tamaño real
    -- task.defer sigue siendo muy rápido, por eso usamos un loop corto de respaldo
    task.defer(function()
        -- Intentar inmediatamente
        updateHeight()
        -- Si el Row aún no tenía ancho, re-intentar tras 2 frames
        if Row.AbsoluteSize.X <= 10 then
            task.wait()
            updateHeight()
            if Row.AbsoluteSize.X <= 10 then
                task.wait(0.1)
                updateHeight()
            end
        end
    end)

    -- Recalcular si la ventana cambia de tamaño
    Row:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        task.defer(updateHeight)
    end)

    -- Registrar para actualizaciones de tema
    registerElementForTheme(Row)

    -- Cargar thumbnail del jugador async
    if options.PlayerImage and rawId ~= 0 then
        task.spawn(function()
            pcall(function()
                local thumb = game:GetService("Players"):GetUserThumbnailAsync(
                    tonumber(rawId),
                    Enum.ThumbnailType.HeadShot,
                    Enum.ThumbnailSize.Size100x100
                )
                if Img and Img.Parent then Img.Image = thumb end
            end)
        end)
    end

    -- Objeto público
    local RowObj = {}

    function RowObj:SetImage(newId)
        if Img and Img.Parent then Img.Image = _toAsset(newId) end
    end

    function RowObj:SetPlayerThumbnail(userId)
        task.spawn(function()
            pcall(function()
                local thumb = game:GetService("Players"):GetUserThumbnailAsync(
                    tonumber(userId),
                    Enum.ThumbnailType.HeadShot,
                    Enum.ThumbnailSize.Size100x100
                )
                if Img and Img.Parent then Img.Image = thumb end
            end)
        end)
    end

    function RowObj:UpdateTitle(text)
        if TitleLabel and TitleLabel.Parent then
            TitleLabel.Text = text or ""
        end
    end

    function RowObj:UpdateContent(text)
        if ContentLabel and ContentLabel.Parent then
            ContentLabel.Text = text or ""
            task.defer(updateHeight)
        end
    end

    function RowObj:GetFrame() return Row end

    return RowObj
end

    -- ============================================================
    -- CreateButtonFloat — botón flotante libre en pantalla
    -- ============================================================
    -- Opciones:
    --   Name         = "Saltar"          Texto (si no hay imagen)
    --   Image        = 0                 AssetId de imagen (opcional)
    --   Width        = 100               Ancho en px  (default 100)
    --   Height       = 40                Alto en px   (default 40)
    --   X            = 0.5               Posición X en escala 0-1 de pantalla
    --   Y            = 0.8               Posición Y en escala 0-1 de pantalla
    --   OffsetX      = 0                 Offset X adicional en px
    --   OffsetY      = 0                 Offset Y adicional en px
    --   Draggable    = true/false        Si se puede arrastrar (default false)
    --   MobileOnly   = true/false        Solo visible en móvil (default false)
    --   PCOnly       = true/false        Solo visible en PC (default false)
    --   CustomColor  = {r,g,b}           Color fijo {255,100,0} — no reacciona al tema
    --                  false/nil         Reacciona automáticamente al tema
    --   CornerRadius = 8                 Redondeo (default 8)
    --   Callback     = function() end
    -- ----------------------------------------------------------------
    -- Métodos:
    --   :Show()          Mostrar
    --   :Hide()          Ocultar
    --   :SetVisible(bool)
    --   :Destroy()       Eliminar completamente
    --   :SetText(str)    Cambiar texto
    --   :SetImage(id)    Cambiar imagen
    --   :SetColor(r,g,b) Cambiar color manualmente
    -- ============================================================
    function TabObj:CreateButtonFloat(options)
        options = options or {}

        local UIS        = game:GetService("UserInputService")
        local TweenSvc   = game:GetService("TweenService")
        local isMobile   = UIS.TouchEnabled
        local isPC       = not isMobile

        -- Visibilidad según plataforma
        local mobileOnly = options.MobileOnly == true
        local pcOnly     = options.PCOnly     == true
        local shouldShow = true
        if mobileOnly and isPC    then shouldShow = false end
        if pcOnly     and isMobile then shouldShow = false end

        -- Dimensiones
        local btnW = options.Width  or 100
        local btnH = options.Height or 40

        -- Color personalizado o del tema
        local useCustomColor = options.CustomColor ~= nil and options.CustomColor ~= false
        local customRGB = useCustomColor and options.CustomColor or nil

        local function getBaseColor()
            if useCustomColor and customRGB then
                return Color3.fromRGB(customRGB[1], customRGB[2], customRGB[3])
            end
            return _themeColor("accent")
        end

        -- Buscar el ScreenGui principal (el que tiene MainFrame)
local targetGui = nil
-- Buscar el ScreenGui principal (el que tiene MainFrame)
        local targetGui = nil
        for _, g in ipairs(CONTAINER:GetChildren()) do
            if g:IsA("ScreenGui") and g:FindFirstChild("MainFrame") then
                targetGui = g
                break
            end
        end
        if not targetGui then
            for _, g in ipairs(CONTAINER:GetChildren()) do
                if g:IsA("ScreenGui") then targetGui = g break end
            end
        end
        -- Crear el botón
        local hasImage = options.Image and options.Image ~= 0 and options.Image ~= ""

        local Btn
        if hasImage then
            Btn = Instance.new("ImageButton")
            Btn.Image = _toAsset(options.Image)
            Btn.ScaleType = Enum.ScaleType.Fit
            Btn.BackgroundColor3 = getBaseColor()
        else
            Btn = Instance.new("TextButton")
            Btn.Text = options.Name or "Botón"
            Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            Btn.Font = Enum.Font.GothamBold
            Btn.TextSize = math.clamp(btnH * 0.38, 10, 22)
            Btn.BackgroundColor3 = getBaseColor()
            Btn.AutoButtonColor = false
        end

        Btn.Name        = "FloatBtn_" .. (options.Name or "btn")
        Btn.Size        = UDim2.new(0, btnW, 0, btnH)
        Btn.Position    = UDim2.new(
            options.X or 0.5, (options.OffsetX or 0) - btnW/2,
            options.Y or 0.8, (options.OffsetY or 0) - btnH/2
        )
        Btn.BorderSizePixel = 0
        Btn.ZIndex      = 50
        Btn.Visible     = shouldShow
        Btn.Parent      = targetGui
        Instance.new("UICorner", Btn).CornerRadius = UDim.new(0, options.CornerRadius or 8)

        -- Sombra sutil
        local Shadow = Instance.new("UIStroke", Btn)
        Shadow.Thickness = 1.5
        Shadow.Color = Color3.fromRGB(0,0,0)
        Shadow.Transparency = 0.6

        -- Hover / press feedback
        Btn.MouseEnter:Connect(function()
            TweenSvc:Create(Btn, TweenInfo.new(0.1), {
                Size = UDim2.new(0, btnW + 6, 0, btnH + 4)
            }):Play()
        end)
        Btn.MouseLeave:Connect(function()
            TweenSvc:Create(Btn, TweenInfo.new(0.1), {
                Size = UDim2.new(0, btnW, 0, btnH)
            }):Play()
        end)
        Btn.MouseButton1Down:Connect(function()
            TweenSvc:Create(Btn, TweenInfo.new(0.07), {
                Size = UDim2.new(0, btnW - 4, 0, btnH - 2)
            }):Play()
        end)
        Btn.MouseButton1Up:Connect(function()
            TweenSvc:Create(Btn, TweenInfo.new(0.1), {
                Size = UDim2.new(0, btnW, 0, btnH)
            }):Play()
        end)

        -- Callback
        Btn.MouseButton1Click:Connect(function()
            if options.Callback then pcall(options.Callback) end
        end)

        -- Arrastre (Draggable)
        if options.Draggable then
            local dragging   = false
            local dragStart  = Vector2.new(0,0)
            local startBtnPos

            local function getDragInput(input)
                return input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch
            end

            Btn.InputBegan:Connect(function(input)
                if getDragInput(input) then
                    dragging    = true
                    dragStart   = Vector2.new(input.Position.X, input.Position.Y)
                    startBtnPos = Btn.Position
                end
            end)

            UIS.InputEnded:Connect(function(input)
                if getDragInput(input) then dragging = false end
            end)

            UIS.InputChanged:Connect(function(input)
                if dragging and (
                    input.UserInputType == Enum.UserInputType.MouseMovement or
                    input.UserInputType == Enum.UserInputType.Touch
                ) then
                    local delta = Vector2.new(input.Position.X, input.Position.Y) - dragStart
                    Btn.Position = UDim2.new(
                        startBtnPos.X.Scale,  startBtnPos.X.Offset  + delta.X,
                        startBtnPos.Y.Scale,  startBtnPos.Y.Offset  + delta.Y
                    )
                end
            end)
        end

        -- Registrar para actualizaciones de tema (solo si no tiene color custom)
        if not useCustomColor then
            -- Se actualiza en applyColorsSmooth buscando por nombre especial
            Btn.Name = "FloatBtn_Theme_" .. (options.Name or "btn")
        end

        -- Objeto público
        local BtnObj = {}

        function BtnObj:Show()
            if shouldShow then Btn.Visible = true end
        end

        function BtnObj:Hide()
            Btn.Visible = false
        end

        function BtnObj:SetVisible(bool)
            if bool and not shouldShow then return end
            Btn.Visible = bool == true
        end

        function BtnObj:Destroy()
            if Btn and Btn.Parent then Btn:Destroy() end
        end

        function BtnObj:SetText(txt)
            if Btn:IsA("TextButton") then Btn.Text = txt or "" end
        end

        function BtnObj:SetImage(id)
            if Btn:IsA("ImageButton") then Btn.Image = _toAsset(id) end
        end

        function BtnObj:SetColor(r, g, b)
            Btn.BackgroundColor3 = Color3.fromRGB(r, g, b)
        end

        return BtnObj
    end

    return TabObj
end

-- ============================================================
-- FLOATING FRAME — panel flotante independiente y personalizable
-- ============================================================
-- options:
--   Name           = "PanelExtra"
--   Title          = "Mi Panel"
--   ShowTitleBar   = true/false          (default true)
--   CloseButton    = true/false          (default true)
--   StartVisible   = true/false          (default false)
--   Size           = {X = 300, Y = 260}  (si no, tamaño auto PC/móvil)
--   Position       = "left"|"right"|"top"|"bottom"  -- pegado al MainFrame
--   ScreenAnchor   = "topleft"|"topright"|"bottomleft"|"bottomright"
--                    |"top"|"bottom"|"left"|"right"|"center" -- pegado a la pantalla
--   Gap            = 12                  -- separación en px
--   AttachToMain   = true/false          (default true si usás Position)
--   CustomPosition = UDim2.new(...)      -- posición fija manual, prioridad máxima
--   Color          = false               -> sigue el tema dinámicamente
--                  = {Base={r,g,b}, Accent={r,g,b}, Input={r,g,b}} -> color fijo propio
-- ------------------------------------------------------------
-- Devuelve:
--   :Show() :Hide() :Toggle() :Destroy() :SetPosition(UDim2)
--   :CreateSection(name) :CreateParagraph(opts) :CreateButton(opts)
--   :CreateToggle(opts) :CreateSlider(opts) :CreateInput(opts)
-- ============================================================
function JmodsLib:CreateFloatingFrame(options)
    options = options or {}

    local UserInputService = game:GetService("UserInputService")
    local TweenService = game:GetService("TweenService")
    local isMobile = UserInputService.TouchEnabled
JmodsLib._FloatingFrames = JmodsLib._FloatingFrames or {}

    local MainFrame = self.MainFrame
    local ScreenGui = MainFrame and MainFrame.Parent or CONTAINER:FindFirstChildWhichIsA("ScreenGui")

    -- ---------- TAMAÑO (auto PC/móvil si no se especifica) ----------
    local defaultW, defaultH
    if isMobile then
        defaultW, defaultH = 260, 220
    else
        defaultW, defaultH = 320, 280
    end
    local width  = (options.Size and options.Size.X) or defaultW
    local height = (options.Size and options.Size.Y) or defaultH

    -- ---------- COLOR (dinámico o fijo) ----------
    local useCustomColor = options.Color ~= nil and options.Color ~= false
    local customBase, customAccent, customInput
    if useCustomColor then
        local c = options.Color
        customBase   = c.Base   and Color3.fromRGB(c.Base[1], c.Base[2], c.Base[3])     or Color3.fromRGB(25,25,35)
        customAccent = c.Accent and Color3.fromRGB(c.Accent[1], c.Accent[2], c.Accent[3]) or Color3.fromRGB(70,70,120)
        customInput  = c.Input  and Color3.fromRGB(c.Input[1], c.Input[2], c.Input[3])   or Color3.fromRGB(50,50,80)
    end

    local baseColor, accentColor, inputColor
    if useCustomColor then
        baseColor, accentColor, inputColor = customBase, customAccent, customInput
    else
        local t = JmodsLib.Theme or {Base=Color3.fromRGB(25,25,35), Accent=Color3.fromRGB(70,70,120), Input=Color3.fromRGB(50,50,80)}
        baseColor, accentColor, inputColor = t.Base, t.Accent, t.Input
    end

    -- ---------- FRAME PRINCIPAL FLOTANTE ----------
    local FloatFrame = Instance.new("Frame")
    FloatFrame.Name = "FloatingFrame_" .. (options.Name or "Panel")
    FloatFrame.Size = UDim2.new(0, width, 0, height)
    FloatFrame.BackgroundColor3 = baseColor
    FloatFrame.BorderSizePixel = 0
    FloatFrame.Visible = options.StartVisible == true
    FloatFrame.ZIndex = options.ZIndex or 60
    FloatFrame.ClipsDescendants = false
    FloatFrame.Parent = ScreenGui
    Instance.new("UICorner", FloatFrame).CornerRadius = UDim.new(0, 14)

    -- Sombra (misma estética que MainFrame)
    local Shadow = Instance.new("ImageLabel", FloatFrame)
    Shadow.Size = UDim2.new(1, 30, 1, 30)
    Shadow.Position = UDim2.new(0, -15, 0, -15)
    Shadow.BackgroundTransparency = 1
    Shadow.Image = "rbxassetid://5028857084"
    Shadow.ImageColor3 = Color3.fromRGB(0,0,0)
    Shadow.ImageTransparency = 0.7
    Shadow.ScaleType = Enum.ScaleType.Slice
    Shadow.SliceCenter = Rect.new(24,24,276,276)
    Shadow.ZIndex = FloatFrame.ZIndex - 1

    -- ---------- TITLEBAR opcional ----------
    local topOffset = 0
    if options.ShowTitleBar ~= false then
        local FTitleBar = Instance.new("Frame", FloatFrame)
        FTitleBar.Name = "TitleBar"
        FTitleBar.Size = UDim2.new(1, 0, 0, 34)
        FTitleBar.BackgroundColor3 = accentColor
        FTitleBar.BorderSizePixel = 0
        FTitleBar.ZIndex = FloatFrame.ZIndex + 1
        Instance.new("UICorner", FTitleBar).CornerRadius = UDim.new(0, 14)

        local FTitle = Instance.new("TextLabel", FTitleBar)
        FTitle.Size = UDim2.new(1, options.CloseButton == false and -16 or -46, 1, 0)
        FTitle.Position = UDim2.new(0, 12, 0, 0)
        FTitle.Text = options.Title or options.Name or "Panel"
        FTitle.Font = Enum.Font.GothamBold
        FTitle.TextSize = 15
        FTitle.TextColor3 = Color3.fromRGB(255,255,255)
        FTitle.BackgroundTransparency = 1
        FTitle.TextXAlignment = Enum.TextXAlignment.Left
        FTitle.ZIndex = FTitleBar.ZIndex + 1

        if options.CloseButton ~= false then
            local FClose = Instance.new("ImageButton", FTitleBar)
            FClose.Size = UDim2.new(0, 26, 0, 26)
            FClose.Position = UDim2.new(1, -32, 0.5, -13)
            FClose.BackgroundTransparency = 1
            FClose.Image = "rbxassetid://116517620289213"
            FClose.ZIndex = FTitleBar.ZIndex + 1
            FClose.MouseButton1Click:Connect(function()
                FloatFrame.Visible = false
            end)
        end

        -- Arrastre de la TitleBar
        local dragging, dragStart, dragPos
        FTitleBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                dragPos = FloatFrame.Position
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                local delta = input.Position - dragStart
                FloatFrame.Position = UDim2.new(dragPos.X.Scale, dragPos.X.Offset + delta.X, dragPos.Y.Scale, dragPos.Y.Offset + delta.Y)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = false
            end
        end)

        topOffset = 34
    end

    -- ---------- CONTENIDO (ScrollingFrame -> nada se corta) ----------
    local FloatPage = Instance.new("ScrollingFrame", FloatFrame)
    FloatPage.Name = "FloatingPage"
    FloatPage.Size = UDim2.new(1, -12, 1, -(topOffset + 12))
    FloatPage.Position = UDim2.new(0, 6, 0, topOffset + 6)
    FloatPage.BackgroundTransparency = 1
    FloatPage.BorderSizePixel = 0
    FloatPage.ScrollBarThickness = 5
    FloatPage.CanvasSize = UDim2.new(0,0,0,0)
    FloatPage.AutomaticCanvasSize = Enum.AutomaticSize.Y
    FloatPage.ScrollingDirection = Enum.ScrollingDirection.Y
    FloatPage.ClipsDescendants = true
    FloatPage.ZIndex = FloatFrame.ZIndex + 1

    local FloatLayout = Instance.new("UIListLayout", FloatPage)
    FloatLayout.SortOrder = Enum.SortOrder.LayoutOrder
    FloatLayout.Padding = UDim.new(0, 6)

    local FloatPadding = Instance.new("UIPadding", FloatPage)
    FloatPadding.PaddingRight = UDim.new(0, 4)

    -- ---------- POSICIONAMIENTO ----------
    -- Prioridad: CustomPosition > Position (pegado al MainFrame) > ScreenAnchor (pegado a pantalla) > default
    local function getScreenAnchorPosition(anchor, gap)
        local camera = workspace.CurrentCamera
        local viewport = (camera and camera.ViewportSize) or Vector2.new(1280, 720)
        anchor = (anchor or "topright"):lower()

        if anchor == "topleft" then
            return UDim2.new(0, gap, 0, gap)
        elseif anchor == "topright" then
            return UDim2.new(0, viewport.X - width - gap, 0, gap)
        elseif anchor == "bottomleft" then
            return UDim2.new(0, gap, 0, viewport.Y - height - gap)
        elseif anchor == "bottomright" then
            return UDim2.new(0, viewport.X - width - gap, 0, viewport.Y - height - gap)
        elseif anchor == "top" then
            return UDim2.new(0.5, -width/2, 0, gap)
        elseif anchor == "bottom" then
            return UDim2.new(0.5, -width/2, 0, viewport.Y - height - gap)
        elseif anchor == "left" then
            return UDim2.new(0, gap, 0.5, -height/2)
        elseif anchor == "right" then
            return UDim2.new(0, viewport.X - width - gap, 0.5, -height/2)
        else -- "center"
            return UDim2.new(0.5, -width/2, 0.5, -height/2)
        end
    end

    local function applyPosition()
        local gap = options.Gap or 12

        -- 1) Posición manual absoluta: máxima prioridad
        if options.CustomPosition then
            FloatFrame.Position = options.CustomPosition
            return
        end

        -- 2) Pegado al MainFrame (si existe MainFrame y se pidió Position)
        if options.Position and MainFrame and MainFrame.Parent then
            local pos = options.Position:lower()
            if pos == "left" then
                FloatFrame.Position = UDim2.new(0, MainFrame.AbsolutePosition.X - width - gap, 0, MainFrame.AbsolutePosition.Y)
            elseif pos == "top" then
                FloatFrame.Position = UDim2.new(0, MainFrame.AbsolutePosition.X, 0, MainFrame.AbsolutePosition.Y - height - gap)
            elseif pos == "bottom" then
                FloatFrame.Position = UDim2.new(0, MainFrame.AbsolutePosition.X, 0, MainFrame.AbsolutePosition.Y + MainFrame.AbsoluteSize.Y + gap)
            else -- "right" por defecto
                FloatFrame.Position = UDim2.new(0, MainFrame.AbsolutePosition.X + MainFrame.AbsoluteSize.X + gap, 0, MainFrame.AbsolutePosition.Y)
            end
            return
        end

        -- 3) Anclado a la pantalla (ScreenAnchor explícito, o fallback si no hay MainFrame)
        if options.ScreenAnchor then
            FloatFrame.Position = getScreenAnchorPosition(options.ScreenAnchor, gap)
            return
        end

        -- 4) DEFAULT: si hay MainFrame, pegarse a la derecha; si no, esquina superior derecha de pantalla
        if MainFrame and MainFrame.Parent then
            FloatFrame.Position = UDim2.new(0, MainFrame.AbsolutePosition.X + MainFrame.AbsoluteSize.X + gap, 0, MainFrame.AbsolutePosition.Y)
        else
            FloatFrame.Position = getScreenAnchorPosition("topright", gap)
        end
    end

    task.defer(applyPosition)

    -- Reposicionar en vivo si está "pegado" al MainFrame y este se mueve/redimensiona
    if options.AttachToMain ~= false and not options.CustomPosition and options.Position and MainFrame then
        MainFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(applyPosition)
        MainFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyPosition)
    end

    -- Reposicionar si cambia el viewport y estamos usando ScreenAnchor
    if options.ScreenAnchor or (not options.Position and not options.CustomPosition) then
        workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
            local cam = workspace.CurrentCamera
            if cam then
                cam:GetPropertyChangedSignal("ViewportSize"):Connect(applyPosition)
            end
        end)
    end

    -- ---------- API PÚBLICA ----------
    local FloatingObj = {Frame = FloatFrame, Page = FloatPage, UseCustomColor = useCustomColor}

function FloatingObj:SyncTheme()
    if self.UseCustomColor then return end -- si tiene color fijo, no lo tocamos
    local t = JmodsLib.Theme or {Base=Color3.fromRGB(25,25,35), Accent=Color3.fromRGB(70,70,120), Input=Color3.fromRGB(50,50,80)}
    baseColor, accentColor, inputColor = t.Base, t.Accent, t.Input
    FloatFrame.BackgroundColor3 = baseColor
    local tb = FloatFrame:FindFirstChild("TitleBar")
    if tb then tb.BackgroundColor3 = accentColor end
    applyThemeToDescendants(FloatFrame, baseColor, accentColor, inputColor)
end

    function FloatingObj:Show()
        FloatFrame.Visible = true
        applyPosition()
    end
    function FloatingObj:Hide()
        FloatFrame.Visible = false
    end
    function FloatingObj:Toggle()
        FloatFrame.Visible = not FloatFrame.Visible
        if FloatFrame.Visible then applyPosition() end
    end
function FloatingObj:Destroy()
    for i, ff in ipairs(JmodsLib._FloatingFrames) do
        if ff == FloatingObj then table.remove(JmodsLib._FloatingFrames, i) break end
    end
    FloatFrame:Destroy()
end
    function FloatingObj:SetPosition(newPos)
        options.CustomPosition = newPos
        applyPosition()
    end

table.insert(JmodsLib._FloatingFrames, FloatingObj)

    -- =========================================================
    -- CREADORES DE ELEMENTOS (misma estética que las Tabs)
    -- =========================================================

