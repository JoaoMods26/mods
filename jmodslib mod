-- SISTEMA DE OBSERVADORES AUTOMÁTICO MEJORADO (independiente del personaje)
-- Reemplaza desde línea ~2750
local function createAutoThemeObserver()
    local lastCheck = tick()
    local checkInterval = 5 -- Aumentar a 5 segundos
    
    task.spawn(function()
        while task.wait(checkInterval) do
            local currentTime = tick()
            
            -- Solo ejecutar si ha pasado suficiente tiempo
            if currentTime - lastCheck < checkInterval then
                continue
            end
            
            lastCheck = currentTime
            
            pcall(function()
                if not CurrentTheme or not ThemeConfigs[CurrentTheme] then return end
                
                local config = ThemeConfigs[CurrentTheme]
                local processed = 0
                local maxProcess = 5 -- Reducir de 10 a 5
                
                -- Limpiar elementos muertos primero
                for i = #ElementsToTheme, 1, -1 do
                    local element = ElementsToTheme[i]
                    if not element or not element.Parent then
                        table.remove(ElementsToTheme, i)
                    end
                end
                
                -- Procesar solo si hay elementos pendientes
                if #ElementsToTheme > 0 then
                    for i = #ElementsToTheme, math.max(1, #ElementsToTheme - maxProcess), -1 do
                        local element = ElementsToTheme[i]
                        if element and element.Parent then
                            for _, descendant in ipairs(element:GetDescendants()) do
                                if not ThemeAppliedElements[descendant] then
                                    applyThemeToElement(descendant, config[1], config[2], config[3])
                                    processed = processed + 1
                                    if processed >= maxProcess then break end
                                end
                            end
                        end
                    end
                end
            end)
        end
    end)
end

-- Iniciar el observador automático
createAutoThemeObserver()



