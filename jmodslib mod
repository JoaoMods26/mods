            if page:IsA("ScrollingFrame") then
                for _, child in ipairs(page:GetChildren()) do
                    if child:IsA("UIListLayout") then continue end
                    
                    if child:IsA("TextButton") then
                        local text = string.lower(child.Text or ""):gsub("%s+", "")
                        child.Visible = string.find(text, query, 1, true) ~= nil
                        
                    elseif child:IsA("Frame") and isSearchableContainer(child) then
                        local found = false
                        
                        for _, descendant in ipairs(child:GetDescendants()) do
                            if descendant:IsA("TextLabel") then
                                local text = string.lower(descendant.Text or ""):gsub("%s+", "")
                                if string.find(text, query, 1, true) then
                                    found = true
                                    break
                                end
                            end
                        end
                        
                        child.Visible = found
                    end
                end
            end
        end
        
        task.wait(0.1)
        searchDebounce = false
    end)
