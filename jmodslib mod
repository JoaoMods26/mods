local LastNotification = nil

-- REEMPLAZA la función JmodsLib:Notify completa (línea ~1517) con esta versión corregida

function JmodsLib:Notify(options)
    options = options or {}
local ScreenGui = CONTAINER:FindFirstChild("JmodsLibNotify")
if not ScreenGui then
